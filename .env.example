# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional: where Chroma persists data (default: <repo>/data/chroma)
# CHROMA_PATH=

# Retrieval (defaults shown). RETRIEVAL_MODE: vector | hybrid (vector + BM25, merged by RRF).
# RERANK=true re-scores the top RETRIEVAL_CANDIDATES with a cross-encoder (downloads ~90 MB on first use).
# RETRIEVAL_MODE=hybrid
# RERANK=false
# RETRIEVAL_CANDIDATES=20

# Requests per client per minute on /chat and /chat/stream (0 = no limit)
# RATE_LIMIT_PER_MINUTE=20

# Comma-separated origins allowed to call the API
# CORS_ORIGINS=http://localhost:5173

# Address of the API as seen by the browser; baked into the web app at build time
# (used by `docker compose build`; for `pnpm dev:web` set it in your shell or in apps/web/.env instead)
# VITE_API_URL=http://localhost:8000
